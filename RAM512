CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address[0..2], a=aa, b=bb, c=cc, d=dd, e=ee, f=ff, g=gg, h=hh);

    RAM64(in=in, load=aa, address=address[3..8], out=ram0);
    RAM64(in=in, load=bb, address=address[3..8], out=ram1);
    RAM64(in=in, load=cc, address=address[3..8], out=ram2);
    RAM64(in=in, load=dd, address=address[3..8], out=ram3);
    RAM64(in=in, load=ee, address=address[3..8], out=ram4);
    RAM64(in=in, load=ff, address=address[3..8], out=ram5);
    RAM64(in=in, load=gg, address=address[3..8], out=ram6);
    RAM64(in=in, load=hh, address=address[3..8], out=ram7);

    Mux8Way16(a=ram0, b=ram1, c=ram2, d=ram3, e=ram4, f=ram5, g=ram6, h=ram7,
                sel=address[0..2], out=out);
  
}
